{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/engineers/:id", "destination": "/api/engineers?id=:id" },
    { "source": "/api/candidates/:id/vote", "destination": "/api/candidates?id=:id&vote=1" },
    { "source": "/api/candidates/:id", "destination": "/api/candidates?id=:id" },
    { "source": "/api/contact-calls", "destination": "/api/history?kind=calls" },
    { "source": "/api/remarks", "destination": "/api/history?kind=remarks" },
    { "source": "/api/urgent", "destination": "/api/reports?type=urgent" },
    { "source": "/api/analytics", "destination": "/api/reports?type=analytics" },
    { "source": "/api/audit-log", "destination": "/api/meta?type=audit" },
    { "source": "/api/election-status", "destination": "/api/meta?type=status" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/styles.css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    },
    {
      "source": "/script.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
