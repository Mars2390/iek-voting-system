# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it's already in .gitignore.

# Neon PostgreSQL connection string.
# Get this from https://console.neon.tech -> your project -> Connection Details.
# Use the "pooled connection" string for serverless functions.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# Sozuri SMS credentials — https://sozuri.net (dashboard -> API/Project settings)
# CONFIRMED: this must be the project's dashboard DISPLAY NAME (e.g. "IEK
# ELECTION"), not its opaque project ID — the ID returns 401 AUTHENTICATION_FAILED.
SOZURI_PROJECT_ID=
SOZURI_API_KEY=
# Alphanumeric sender ID shown to recipients. Most SMS gateways cap this at
# 11 characters (GSM alphanumeric sender ID limit) — keep it short.
SOZURI_SENDER=
# Optional — the "Auth Key" you register under Sozuri dashboard -> Manage
# API -> Callback URLs. If set, incoming webhook calls to /api/sms-reply
# and /api/sms-status are checked against it; if unset, both are accepted
# unverified (fine for initial testing, not for production).
SOZURI_CALLBACK_KEY=
