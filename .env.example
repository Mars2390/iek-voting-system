# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it's already in .gitignore.

# Neon PostgreSQL connection string.
# Get this from https://console.neon.tech -> your project -> Connection Details.
# Use the "pooled connection" string for serverless functions.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require
